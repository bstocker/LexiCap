# Copier ce fichier en .env et adapter les valeurs.

# Environnement : development ou production
FLASK_ENV=development

# Clé secrète — GÉNÉRER une valeur aléatoire pour la production
# (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Base de données — par défaut SQLite local. Exemple PostgreSQL :
# DATABASE_URL=postgresql://user:password@localhost:5432/lexicap

# Dossier d'upload et taille max (octets)
# UPLOAD_FOLDER=instance/uploads
# MAX_CONTENT_LENGTH=10485760

# Jeton du webhook de déploiement (/deploy) — doit être identique au secret
# GitHub DEPLOY_TOKEN. Générer une valeur aléatoire :
#   python -c "import secrets; print(secrets.token_hex(32))"
# DEPLOY_TOKEN=change-me

# Proxy sortant — UNIQUEMENT sur un compte PythonAnywhere gratuit, si le
# git pull du webhook échoue avec une erreur réseau. Laisser vide sinon.
# HTTPS_PROXY=http://proxy.server:3128
# HTTP_PROXY=http://proxy.server:3128
